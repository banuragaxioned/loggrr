{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loggrr",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_names": false,
  "placement": {
    "region": "aws:eu-central-1",
  },
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "loggrr",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "loggrr-cache",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "account_id": "9b8d8be0814b997413c7fd610e884fd0",
  "vars": {
    "NEXTAUTH_URL": "https://loggrr.axioned.workers.dev",
    "NEXT_PUBLIC_APP_URL": "https://loggrr.axioned.workers.dev",
    "NODE_ENV": "production",
    "GOOGLE_CLIENT_ID": "472681797458-plh1nl99mpnr9fohe85l06rcak1dsdjm.apps.googleusercontent.com",
    "EMAIL_FROM": "loggr@axioned.com",
    "EMAIL_HOST": "email-smtp.ap-south-1.amazonaws.com",
    "EMAIL_PORT": "587",
    "EMAIL_USER": "AKIAUHJZM72YH62KUNHJ",
    "NEXT_PUBLIC_POSTHOG_HOST": "https://app.posthog.com",
    "NEXT_PUBLIC_POSTHOG_KEY": "phc_gDPvH5mHQzgJBZ2yqEdbZ84aFOfq7Nd8GYL3vPZC9VH"
  },
}
